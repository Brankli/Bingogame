# Application
NODE_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
CORS_ORIGIN=http://localhost:8080

# Server database: mysql or postgres
DB_TYPE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=secret
DB_NAME=bingo

# For PostgreSQL instead, use:
# DB_TYPE=postgres
# DB_PORT=5432

# Redis (cache + optional Socket.IO scaling)
REDIS_HOST=localhost
REDIS_PORT=6379

# Admin bootstrap (first run only — required in production)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Central account synchronization (optional on local development)
SYNC_SERVER_URL=https://sync.example.invalid
SYNC_ADMIN_TOKEN=
SYNC_ENROLLMENT_TOKEN=
SYNC_PUBLISH_ENROLLMENT_TOKEN=
SYNC_DEVICE_ROLE=reader
OFFLINE_AUTH_DAYS=30

# Required in the packaged Electron app through %APPDATA%/Bingo/config.json.
# Never commit or package this file.
SYNC_DEVICE_ID=
SYNC_DEVICE_SECRET=

# Client (Vue)
VUE_APP_API_URL=http://localhost:3000

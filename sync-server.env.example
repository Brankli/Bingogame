NODE_ENV=production
PORT=3000
SECRET_KEY=replace-with-a-random-32-character-secret
CORS_ORIGIN=https://sync-admin.example.com

SYNC_SERVER_MODE=true
SYNC_SERVER_SECRET=replace-with-a-long-random-server-pepper
SYNC_ENROLLMENT_TOKEN=replace-with-a-device-enrollment-token
SYNC_PUBLISH_ENROLLMENT_TOKEN=replace-with-a-publisher-enrollment-token
SYNC_ADMIN_TOKEN=replace-with-a-separate-sync-admin-token

SYNC_DB_HOST=127.0.0.1
SYNC_DB_PORT=3306
SYNC_DB_USER=bingo_sync
SYNC_DB_PASS=replace-with-a-database-password
SYNC_DB_NAME=bingo_sync
